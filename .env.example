# Never expose this value to the extension or browser.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Server-only Supabase Storage configuration. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_BUCKET_NAME="ListingKing-ImageStorage"

# Server-only Groq AI key. `openai/gpt-oss-20b` is the current fast structured-output model.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"

# Optional legacy Gemini fallback. Without an AI provider ListingKing uses the local draft generator.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
